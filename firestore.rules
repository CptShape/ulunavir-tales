rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function storyDoc(storyId) {
      return get(/databases/$(database)/documents/stories/$(storyId));
    }

    function arcDoc(arcId) {
      return get(/databases/$(database)/documents/arcs/$(arcId));
    }

    function ownsStoryById(storyId) {
      return signedIn() && storyDoc(storyId).data.creatorId == request.auth.uid;
    }

    function editsStoryById(storyId) {
      return signedIn()
        && request.auth.token.email != null
        && storyDoc(storyId).data.editorEmails is list
        && request.auth.token.email in storyDoc(storyId).data.editorEmails;
    }

    function storyIsSharedById(storyId) {
      return storyDoc(storyId).data.visibility == "public"
        || storyDoc(storyId).data.visibility == "unlisted";
    }

    function canReadStoryById(storyId) {
      return storyIsSharedById(storyId) || ownsStoryById(storyId) || editsStoryById(storyId);
    }

    function canEditStoryById(storyId) {
      return signedIn()
        && (
          storyDoc(storyId).data.creatorId == request.auth.uid
          || editsStoryById(storyId)
          || (
            request.auth.token.email != null
            && storyDoc(storyId).data.pendingTransferStatus == "pending"
            && storyDoc(storyId).data.pendingTransferEmailLower == request.auth.token.email
          )
        );
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /stories/{storyId} {
      allow read: if signedIn()
        || resource.data.visibility == "public"
        || resource.data.visibility == "unlisted";
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if canEditStoryById(storyId);
      allow delete: if ownsStoryById(storyId);
    }

    match /arcs/{arcId} {
      allow read: if canReadStoryById(resource.data.storyId);
      allow create: if signedIn() && canEditStoryById(request.resource.data.storyId);
      allow update, delete: if canEditStoryById(resource.data.storyId);
    }

    match /chapters/{chapterId} {
      allow read: if canReadStoryById(arcDoc(resource.data.arcId).data.storyId);
      allow create: if signedIn() && canEditStoryById(arcDoc(request.resource.data.arcId).data.storyId);
      allow update, delete: if canEditStoryById(arcDoc(resource.data.arcId).data.storyId);
    }
  }
}
