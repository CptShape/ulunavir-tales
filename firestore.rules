rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsStory(storyId) {
      return signedIn()
        && get(/databases/$(database)/documents/stories/$(storyId)).data.creatorId == request.auth.uid;
    }

    function ownsArc(arcId) {
      return signedIn()
        && get(/databases/$(database)/documents/arcs/$(arcId)).data.storyId is string
        && ownsStory(get(/databases/$(database)/documents/arcs/$(arcId)).data.storyId);
    }

    function transferRecipient(storyData) {
      return signedIn()
        && request.auth.token.email is string
        && storyData.pendingTransferStatus == "pending"
        && (
          storyData.pendingTransferEmailLower == request.auth.token.email.lower()
          || (
            storyData.pendingTransfer.targetEmail is string
            && storyData.pendingTransfer.targetEmail.lower() == request.auth.token.email.lower()
          )
        );
    }

    function canReadStory(storyData) {
      return storyData.visibility == "public"
        || storyData.visibility == "unlisted"
        || (signedIn() && storyData.creatorId == request.auth.uid)
        || transferRecipient(storyData);
    }

    function transferAcceptanceAllowed() {
      return transferRecipient(resource.data)
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.pendingTransfer == null
        && request.resource.data.pendingTransferEmailLower == ""
        && request.resource.data.pendingTransferStatus == "";
    }

    function transferDeclineAllowed() {
      return transferRecipient(resource.data)
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.creatorName == resource.data.creatorName
        && request.resource.data.pendingTransfer == null
        && request.resource.data.pendingTransferEmailLower == ""
        && request.resource.data.pendingTransferStatus == "";
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /stories/{storyId} {
      allow read: if canReadStory(resource.data);
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if (signedIn() && resource.data.creatorId == request.auth.uid)
        || transferAcceptanceAllowed()
        || transferDeclineAllowed();
      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;
    }

    match /arcs/{arcId} {
      allow read: if exists(/databases/$(database)/documents/stories/$(resource.data.storyId))
        && canReadStory(get(/databases/$(database)/documents/stories/$(resource.data.storyId)).data);
      allow create: if signedIn() && ownsStory(request.resource.data.storyId);
      allow update, delete: if ownsArc(arcId);
    }

    match /chapters/{chapterId} {
      allow read: if exists(/databases/$(database)/documents/arcs/$(resource.data.arcId))
        && canReadStory(get(/databases/$(database)/documents/stories/$(get(/databases/$(database)/documents/arcs/$(resource.data.arcId)).data.storyId)).data);
      allow create: if signedIn() && ownsArc(request.resource.data.arcId);
      allow update, delete: if ownsArc(resource.data.arcId);
    }
  }
}
