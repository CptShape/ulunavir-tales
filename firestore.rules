rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function storyDoc(storyId) {
      return get(/databases/$(database)/documents/stories/$(storyId));
    }

    function arcDoc(arcId) {
      return get(/databases/$(database)/documents/arcs/$(arcId));
    }

    function ownsStoryById(storyId) {
      return signedIn() && storyDoc(storyId).data.creatorId == request.auth.uid;
    }

    function canEditStoryById(storyId) {
      return signedIn()
        && (
          storyDoc(storyId).data.creatorId == request.auth.uid
          || (
            request.auth.token.email != null
            && storyDoc(storyId).data.pendingTransferStatus == "pending"
            && storyDoc(storyId).data.pendingTransfer.targetEmail == request.auth.token.email
          )
        );
    }

    function ownsArcById(arcId) {
      return signedIn()
        && ownsStoryById(arcDoc(arcId).data.storyId);
    }

    function canEditArcById(arcId) {
      return signedIn()
        && canEditStoryById(arcDoc(arcId).data.storyId);
    }

    function isTransferRecipient() {
      return signedIn()
        && request.auth.token.email != null
        && resource.data.pendingTransferStatus == "pending"
        && resource.data.pendingTransfer.targetEmail == request.auth.token.email;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if canEditStoryById(storyId);
      allow delete: if ownsStoryById(storyId);
    }

    match /arcs/{arcId} {
      allow read: if signedIn();
      allow create: if signedIn() && canEditStoryById(request.resource.data.storyId);
      allow update, delete: if canEditArcById(arcId);
    }

    match /chapters/{chapterId} {
      allow read: if signedIn();
      allow create: if signedIn() && canEditArcById(request.resource.data.arcId);
      allow update, delete: if canEditArcById(resource.data.arcId);
    }
  }
}
